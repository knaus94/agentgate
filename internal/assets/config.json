{
  "version": 1,
  "max_parallel": 4,
  "worker_memory_mib": 512,
  "retention_days": 14,
  "staging": {
    "max_files": 25,
    "max_streams": 5,
    "isolate": "auto"
  },
  "worktree": {
    "default": false,
    "copy": [],
    "setup": [],
    "setup_timeout_s": 1800
  },
  "models": {
    "opus": {
      "provider": "claude",
      "model": "claude-opus-5-5",
      "pool": "claude"
    },
    "sonnet": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "pool": "claude"
    },
    "fable": {
      "provider": "claude",
      "model": "claude-fable-5-2",
      "pool": "fable"
    },
    "sol": {
      "provider": "codex",
      "model": "gpt-6.1-sol",
      "pool": "codex"
    },
    "astra": {
      "provider": "codex",
      "model": "gpt-6-astra",
      "pool": "codex"
    }
  },
  "fallbacks": {},
  "reviewers_excluded": [
    "sol"
  ],
  "ui_designer": "astra:medium",
  "visual_reviewer": "astra:high",
  "consultant": "sonnet:medium",
  "playwright_mcp": "~/.local/share/agentgate/playwright-mcp/node_modules/@playwright/mcp/cli.js",
  "modes": {
    "light": {
      "scout": "",
      "architecture": [],
      "critique": false,
      "backend": "sol:high",
      "frontend": "sol:high",
      "review": [
        {
          "axes": [
            "correctness",
            "architecture",
            "simplicity"
          ],
          "route": "astra:medium"
        }
      ],
      "blocking": [
        "P0",
        "P1"
      ],
      "escalate_to": "xhigh",
      "ui_designer": "astra:medium"
    },
    "medium": {
      "scout": "sol:medium",
      "architecture": [
        "opus:high"
      ],
      "critique": false,
      "backend": "sol:xhigh",
      "frontend": "sol:xhigh",
      "review": [
        {
          "axes": [
            "correctness",
            "architecture",
            "simplicity"
          ],
          "route": "opus:high"
        }
      ],
      "blocking": [
        "P0",
        "P1"
      ],
      "escalate_to": "xhigh",
      "ui_designer": "astra:medium"
    },
    "heavy": {
      "scout": "",
      "architecture": [
        "fable:high",
        "astra:high"
      ],
      "critique": false,
      "architecture_timeout_s": 900,
      "reviewer_timeout_s": 1200,
      "backend": "opus:high",
      "frontend": "astra:high",
      "review": [
        {
          "axes": [
            "architecture",
            "simplicity"
          ],
          "route": "fable:high"
        },
        {
          "axes": [
            "correctness"
          ],
          "route": "opus:high"
        }
      ],
      "blocking": [
        "P0",
        "P1",
        "P2"
      ],
      "escalate_to": "xhigh",
      "ui_designer": "astra:high"
    },
    "ultra": {
      "scout": "",
      "architecture": [
        "fable:xhigh",
        "astra:xhigh"
      ],
      "critique": true,
      "architecture_timeout_s": 1800,
      "writer_timeout_s": 3600,
      "reviewer_timeout_s": 1800,
      "backend": "opus:xhigh",
      "frontend": "astra:xhigh",
      "review": [
        {
          "axes": [
            "architecture",
            "simplicity"
          ],
          "route": "fable:high"
        },
        {
          "axes": [
            "correctness"
          ],
          "route": "fable:xhigh"
        },
        {
          "axes": [
            "correctness"
          ],
          "route": "opus:xhigh"
        },
        {
          "axes": [
            "security"
          ],
          "route": "opus:high"
        }
      ],
      "blocking": [
        "P0",
        "P1",
        "P2"
      ],
      "escalate_to": "max",
      "ui_designer": "astra:xhigh"
    }
  }
}
